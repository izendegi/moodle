{{!
    Legacy alias for section image partial.
}}
{{^isdelegatedsection}}
    <span class="muonline-editor-image text-center" {{#editing}} data-section="{{num}}" data-true-sectionid="{{id}}" data-muonline-action="launch-muonline-icon-picker"{{/editing}} id="tileicon_{{num}}">
    {{^hasphoto}}
        {{#tilenumber}}{{>format_muonline/tilenumber}}{{/tilenumber}}
        {{^tilenumber}}
            <span class="tile-icon" role="button">
                {{#tileicon}}
                    {{#pix}}tileicon/{{{tileicon}}}, format_muonline{{/pix}}
                {{/tileicon}}
            </span>
        {{/tilenumber}}
    {{/hasphoto}}
        {{#hasphoto}}
            <a class="tilebarphoto" data-imagetype="{{#isdraftfile}}draftfile{{/isdraftfile}}{{^isdraftfile}}tilephoto{{/isdraftfile}}"
               href="{{{phototileediturl}}}" style="background-image: url({{{phototileurl}}});"></a>
        {{/hasphoto}}
    </span>
{{/isdelegatedsection}}
