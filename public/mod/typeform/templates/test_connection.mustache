{{!
    @template mod_typeform/test_connection

    Test connection page for Typeform API.

    Context variables required for this template:
    * hastoken - Whether API token is configured
    * apitoken - Masked API token
    * allowedworkspaces - Allowed workspaces display
    * testresults - Array of test results
    * sampleforms - Array of sample forms (first 5)
    * formcount - Total form count
    * returnurl - Return URL
    * summary - Summary object with passed, failed, allpassed

    Example context (json):
    {
        "hastoken": true,
        "apitoken": "tfp_1234...5678",
        "allowedworkspaces": "All workspaces (none configured)",
        "testresults": [
            {
                "test": "Testing API connection",
                "result": true
            },
            {
                "test": "Testing forms retrieval",
                "result": true,
                "count": 10
            }
        ],
        "sampleforms": [
            {
                "title": "Survey 1",
                "workspace": "Workspace A"
            }
        ],
        "formcount": 10,
        "returnurl": "/admin/settings.php?section=modsettingtypeform",
        "summary": {
            "passed": 2,
            "failed": 0,
            "allpassed": true
        }
    }
}}
{{#hastoken}}
<div class="typeform-test-config">
    <h3>{{#str}}configuration, typeform{{/str}}</h3>
    <dl class="row">
        <dt>{{#str}}apitoken, typeform{{/str}}:</dt>
        <dd>{{apitoken}}</dd>
        <dt>{{#str}}allowedworkspaces, typeform{{/str}}:</dt>
        <dd>{{allowedworkspaces}}</dd>
    </dl>
</div>

<div class="typeform-test-results">
    <h3>{{#str}}testresults, typeform{{/str}}</h3>

    {{#testresults}}
        <h4>{{testnumber}}. {{test}}</h4>
        {{#notification}}
            {{> core/notification}}
        {{/notification}}
        {{#hasforms}}
            <ul>
                {{#sampleforms}}
                    <li>{{title}}{{#workspace}} ({{workspace}}){{/workspace}}</li>
                {{/sampleforms}}
                {{#hasmoreforms}}
                    <li>{{#str}}andmoreforms, typeform, {{morecount}}{{/str}}</li>
                {{/hasmoreforms}}
            </ul>
        {{/hasforms}}
    {{/testresults}}
</div>

<div class="typeform-test-summary">
    <h3>{{#str}}summary, typeform{{/str}}</h3>
    {{#summary.notification}}
        {{> core/notification}}
    {{/summary.notification}}
</div>

<div class="mt-3">
    <a href="{{returnurl}}" class="btn btn-secondary">{{#str}}back, typeform{{/str}}</a>
</div>
{{/hastoken}}
{{^hastoken}}
{{#notokennotification}}
    {{> core/notification}}
{{/notokennotification}}
{{/hastoken}}

