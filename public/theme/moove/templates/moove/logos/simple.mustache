{{!
    @template theme_moove/moove/logos/simple

    Simple with heading frontpage logos section: a centered heading and
    subtitle on top, logos spaced evenly in a row below.

    Context variables required for this template:
    * logostitle - The section title text
    * logossubtitle - The section subtitle text
    * logos - Array of logo objects (image, url, hasurl)

    Example context (json):
    {
        "logostitle": "Trusted by the world's most innovative teams",
        "logossubtitle": "",
        "logos": [
            {"image": "https://example.com/logo.svg", "url": "https://example.com", "hasurl": true}
        ]
    }
}}
<section id="logos" class="logos-layout-simple">
    <div class="container text-center">
        {{#logostitle}}<h2 class="logos-title">{{{logostitle}}}</h2>{{/logostitle}}
        {{#logossubtitle}}<p class="logos-subtitle mx-auto">{{{logossubtitle}}}</p>{{/logossubtitle}}

        <div class="d-flex flex-wrap justify-content-center align-items-center logos-simple-list">
            {{#logos}}
                <div class="logos-simple-item">
                    {{#hasurl}}<a href="{{{url}}}" target="_blank" rel="noopener">{{/hasurl}}
                    <img src="{{{image}}}" alt="">
                    {{#hasurl}}</a>{{/hasurl}}
                </div>
            {{/logos}}
        </div>
    </div>
</section>
