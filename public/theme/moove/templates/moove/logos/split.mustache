{{!
    @template theme_moove/moove/logos/split

    Split with logos on right frontpage logos section: heading and subtitle
    in a left column, logos in a grid on the right column.

    Context variables required for this template:
    * logostitle - The section title text
    * logossubtitle - The section subtitle text
    * logos - Array of logo objects (image, url, hasurl)

    Example context (json):
    {
        "logostitle": "Trusted by the world's most innovative teams",
        "logossubtitle": "Join thousands of teams already using our platform.",
        "logos": [
            {"image": "https://example.com/logo.svg", "url": "https://example.com", "hasurl": true}
        ]
    }
}}
<section id="logos" class="logos-layout-split">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-5 mb-4 mb-lg-0">
                {{#logostitle}}<h2 class="logos-title">{{{logostitle}}}</h2>{{/logostitle}}
                {{#logossubtitle}}<p class="logos-subtitle">{{{logossubtitle}}}</p>{{/logossubtitle}}
            </div>
            <div class="col-lg-7">
                <div class="row row-cols-2 row-cols-sm-3 g-4 align-items-center logos-split-list">
                    {{#logos}}
                        <div class="col logos-split-item">
                            {{#hasurl}}<a href="{{{url}}}" target="_blank" rel="noopener">{{/hasurl}}
                            <img src="{{{image}}}" alt="">
                            {{#hasurl}}</a>{{/hasurl}}
                        </div>
                    {{/logos}}
                </div>
            </div>
        </div>
    </div>
</section>
