{{!
    @template theme_moove/slideshow/colorblock

    Frontpage slideshow with a vivid gradient background and the photo shown as a
    tilted, framed print.

    Context variables required for this template:
    * slidersingleslide - true when there is only one slide
    * slides - Array of slide objects (key, active, image, title, caption, hascaption)
    * slideshowcolorblockcolor1 - Start color of the gradient background
    * slideshowcolorblockcolor2 - End color of the gradient background

    Example context (json):
    {
        "slidersingleslide": true,
        "slideshowcolorblockcolor1": "#0f47ad",
        "slideshowcolorblockcolor2": "#17a2b8",
        "slides": [
            {"key": 0, "active": true, "image": "https://example.com/slide.jpg", "title": "Welcome", "caption": "<p>Caption</p>", "hascaption": true}
        ]
    }
}}
<div id="mooveslideshow" class="container-fluid slideshow-layout-colorblock" style="background: linear-gradient(135deg, {{slideshowcolorblockcolor1}} 0%, {{slideshowcolorblockcolor2}} 100%);">
    <div id="moove-carousel" class="carousel slide">
        {{^slidersingleslide}}
            <div class="carousel-indicators">
                {{#slides}}
                    <button type="button" data-bs-target="#moove-carousel" data-bs-slide-to="{{{ key }}}" {{#active}}class="active" aria-current="true"{{/active}} aria-label="{{title}}"></button>
                {{/slides}}
            </div>
        {{/slidersingleslide}}
        <div class="carousel-inner">
            {{#slides}}
                <div class="carousel-item {{#active}}active{{/active}}">
                    <div class="row align-items-center g-0 slide-row">
                        <div class="col-lg-6 slide-text">
                            {{#hascaption}}
                                {{#title}}
                                    <h5 class="title">{{.}}</h5>
                                {{/title}}
                                {{#caption}}
                                    <div class="caption">
                                        {{{.}}}
                                    </div>
                                {{/caption}}
                            {{/hascaption}}
                        </div>
                        <div class="col-lg-6 slide-frame">
                            <div class="slide-photo">
                                <img src="{{image}}" alt="{{title}}" class="d-block w-100">
                            </div>
                        </div>
                    </div>
                </div>
            {{/slides}}
        </div>
        {{^slidersingleslide}}
            <button class="carousel-control-prev" type="button" data-bs-target="#moove-carousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">{{#str}}previous{{/str}}</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#moove-carousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">{{#str}}next{{/str}}</span>
            </button>
        {{/slidersingleslide}}
    </div>
</div>
{{#js}}
    require(['jquery'], function($) {
        $('#moove-carousel').carousel({
            interval: 5000
        });
    });
{{/js}}
