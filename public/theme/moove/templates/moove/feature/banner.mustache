{{!
    @template theme_moove/moove/feature/banner

    Banner frontpage feature section: heading on a highlighted color strip,
    with the boxes overlapping the bottom edge of the banner.

    Context variables required for this template:
    * marketingheading - The section heading html
    * marketingcontent - The section content html
    * marketingboxes - Array of box objects (icon, heading, content)

    Example context (json):
    {
        "marketingheading": "<p>Awesome App Features</p>",
        "marketingcontent": "<p>Moove is a Moodle template.</p>",
        "marketingboxes": [
            {"icon": "https://example.com/icon.svg", "heading": "<p>Lorem</p>", "content": "<p>Lorem ipsum</p>"}
        ]
    }
}}
<section id="feature" class="feature-layout-banner">
    <div class="feature-banner-heading">
        <div class="container text-center">
            <h3 class="h1 mt-3 mb-3">{{{marketingheading}}}</h3>
            <div class="marketing-content mx-auto">{{{marketingcontent}}}</div>
        </div>
    </div>
    <div class="container">
        <div class="row feature-banner-boxes justify-content-center">
            {{#marketingboxes}}
                <div class="col-sm-6 col-lg-3">
                    <div class="card card-body shadow text-center h-100">
                        <div class="icon-lg text-white rounded-circle mx-auto mb-3">
                            <img src="{{{icon}}}">
                        </div>
                        <h5>{{{heading}}}</h5>
                        <div class="box-content">{{{content}}}</div>
                    </div>
                </div>
            {{/marketingboxes}}
        </div>
    </div>
</section>
