{{!
    @template theme_moove/moove/feature/icons

    Simple four-column frontpage feature section: centered heading on top,
    boxes in a responsive 4-column grid, each with a badge icon sitting
    beside the heading and the description wrapping below it.

    Context variables required for this template:
    * marketingheading - The section heading html
    * marketingcontent - The section content html
    * marketingboxes - Array of box objects (icon, heading, content)

    Example context (json):
    {
        "marketingheading": "<p>Awesome App Features</p>",
        "marketingcontent": "<p>Moove is a Moodle template.</p>",
        "marketingboxes": [
            {"icon": "https://example.com/icon.svg", "heading": "<p>Lorem</p>", "content": "<p>Lorem ipsum</p>"}
        ]
    }
}}
<section id="feature" class="feature-layout-icons">
    <div class="container">
        <div class="text-center">
            <h3 class="h1 mt-3 mb-3">{{{marketingheading}}}</h3>
            <div class="marketing-content mx-auto">{{{marketingcontent}}}</div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 feature-icons-list">
            {{#marketingboxes}}
                <div class="col">
                    <div class="feature-icons-item">
                        <div class="icon-lg text-white rounded-3">
                            <img src="{{{icon}}}">
                        </div>
                        <h5>{{{heading}}}</h5>
                        <div class="box-content">{{{content}}}</div>
                    </div>
                </div>
            {{/marketingboxes}}
        </div>
    </div>
</section>
