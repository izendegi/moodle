{{!
    @template theme_moove/moove/faq/twocolumns

    Two columns with centered introduction frontpage FAQ section: heading
    centered on top, questions and answers always visible, split evenly
    between two columns below.

    Context variables required for this template:
    * faqcolumn1 - First half of the question objects (question, answer)
    * faqcolumn2 - Second half of the question objects (question, answer)

    Example context (json):
    {
        "faqcolumn1": [
            {"question": "<p>Lorem?</p>", "answer": "<p>Lorem ipsum.</p>"}
        ],
        "faqcolumn2": [
            {"question": "<p>Ipsum?</p>", "answer": "<p>Dolor sit amet.</p>"}
        ]
    }
}}
<section id="faq" class="faq-layout-twocolumns scale-up scale-up-show">
    <div class="moove-container-fluid">
        <div class="text-center faq-twocolumns-heading mx-auto">
            <h2>{{#str}}faq, theme_moove{{/str}}</h2>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <dl class="faq-twocolumns-list mb-0">
                    {{#faqcolumn1}}
                        <div class="faq-twocolumns-item">
                            <dt>{{{question}}}</dt>
                            <dd>{{{answer}}}</dd>
                        </div>
                    {{/faqcolumn1}}
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="faq-twocolumns-list mb-0">
                    {{#faqcolumn2}}
                        <div class="faq-twocolumns-item">
                            <dt>{{{question}}}</dt>
                            <dd>{{{answer}}}</dd>
                        </div>
                    {{/faqcolumn2}}
                </dl>
            </div>
        </div>
    </div>
</section>
