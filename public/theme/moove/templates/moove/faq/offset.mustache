{{!
    @template theme_moove/moove/faq/offset

    Offset with supporting text frontpage FAQ section: heading and supporting
    text in a narrow left column, questions and answers always visible in a
    wider, offset right column.

    Context variables required for this template:
    * faq - Array of question objects (question, answer)
    * supportemaillink - Html for the contact support link, or empty

    Example context (json):
    {
        "faq": [
            {"question": "<p>Lorem?</p>", "answer": "<p>Lorem ipsum.</p>"}
        ],
        "supportemaillink": "<a href=\"#\">Contact support</a>"
    }
}}
<section id="faq" class="faq-layout-offset scale-up scale-up-show">
    <div class="moove-container-fluid">
        <div class="row">
            <div class="col-lg-4 mb-4 mb-lg-0">
                <h2>{{#str}}faq, theme_moove{{/str}}</h2>
                <p class="faq-offset-support">{{#str}}faqsupporttext, theme_moove{{/str}}</p>
                {{#supportemaillink}}
                    <div class="mt-3">{{{supportemaillink}}}</div>
                {{/supportemaillink}}
            </div>
            <div class="col-lg-7 offset-lg-1">
                <dl class="faq-offset-list mb-0">
                    {{#faq}}
                        <div class="faq-offset-item">
                            <dt>{{{question}}}</dt>
                            <dd>{{{answer}}}</dd>
                        </div>
                    {{/faq}}
                </dl>
            </div>
        </div>
    </div>
</section>
