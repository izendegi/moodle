{{!
    @template theme_moove/moove/numbers/backgroundimage

    With background image frontpage numbers section: full-bleed photo with a dark
    overlay, left-aligned heading/content, and stats below with the big number
    shown above its label, all in white text.

    Context variables required for this template:
    * numberscontent - The section content html
    * numbersbackgroundimage - Url of the background image
    * numbersusers - The active users count
    * numberscourses - The active courses count

    Example context (json):
    {
        "numberscontent": "<h2>Trusted by 25,000+ happy customers.</h2>",
        "numbersbackgroundimage": "https://example.com/background.jpg",
        "numbersusers": 2500,
        "numberscourses": 120
    }
}}
<section id="numbers" class="numbers-layout-backgroundimage" style="background-image: url('{{{numbersbackgroundimage}}}');">
    <div class="numbers-backgroundimage-overlay"></div>
    <div class="container">
        <div class="sectionheading numbers-backgroundimage-heading">
            {{{numberscontent}}}
        </div>

        <dl class="row row-cols-1 row-cols-sm-2 g-4 mt-4 numbers-backgroundimage-list">
            <div class="col d-flex flex-column-reverse numbers-backgroundimage-item">
                <dt class="numbers-backgroundimage-label">{{#str}}numbersusers, theme_moove{{/str}}</dt>
                <dd class="numbers-backgroundimage-value">{{{numbersusers}}}</dd>
            </div>
            <div class="col d-flex flex-column-reverse numbers-backgroundimage-item">
                <dt class="numbers-backgroundimage-label">{{#str}}numberscourses, theme_moove{{/str}}</dt>
                <dd class="numbers-backgroundimage-value">{{{numberscourses}}}</dd>
            </div>
        </dl>
    </div>
</section>
