{{!
    @template theme_moove/moove/numbers/simplegrid

    Simple grid frontpage numbers section: centered heading on top, stats below
    in a simple grid with the big number shown above its label.

    Context variables required for this template:
    * numberscontent - The section content html
    * numbersusers - The active users count
    * numberscourses - The active courses count

    Example context (json):
    {
        "numberscontent": "<h2>Trusted by 25,000+ happy customers.</h2>",
        "numbersusers": 2500,
        "numberscourses": 120
    }
}}
<section id="numbers" class="numbers-layout-simplegrid">
    <div class="container text-center">
        <div class="sectionheading mx-auto">
            {{{numberscontent}}}
        </div>

        <dl class="row row-cols-1 row-cols-sm-2 g-4 g-sm-5 mt-4 justify-content-center numbers-simplegrid-list">
            <div class="col d-flex flex-column mx-auto numbers-simplegrid-item">
                <dt class="numbers-simplegrid-label">{{#str}}numbersusers, theme_moove{{/str}}</dt>
                <dd class="order-first numbers-simplegrid-value">{{{numbersusers}}}</dd>
            </div>
            <div class="col d-flex flex-column mx-auto numbers-simplegrid-item">
                <dt class="numbers-simplegrid-label">{{#str}}numberscourses, theme_moove{{/str}}</dt>
                <dd class="order-first numbers-simplegrid-value">{{{numberscourses}}}</dd>
            </div>
        </dl>
    </div>
</section>
